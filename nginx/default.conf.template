# front door for the stack: serves the frontend and forwards API requests
# the nginx image fills in ${SERVER_NAME} from the environment when it starts
server {
    listen 80;

    # placeholder until we have a real domain (set in .env)
    # this is the only server block, so it also answers requests for any other hostname
    server_name ${SERVER_NAME};

    # reports are small JSON, nothing big should come in
    client_max_body_size 64k;

    root /usr/share/nginx/html;

    # the frontend. no-cache makes browsers check for a new version of the page
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }

    # built js/css have a hash in their names, so they can be cached for good
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # the API
    location ~ ^/(health|reports|docs|redoc|openapi\.json) {
        # 127.0.0.11 is Docker's DNS. using a variable makes nginx look up "api" as
        # requests come in, so it still finds the API after that container is recreated
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:8001;
        proxy_pass $api_upstream;

        # tell the API who originally asked
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
